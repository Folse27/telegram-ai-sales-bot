# Copy to .env and fill in. .env is git-ignored; on a host (e.g. Render) set the same keys in its dashboard.
# Required values are marked REQUIRED: the bot refuses to start without them and names what is missing.

# --- Telegram ---
# REQUIRED. From @BotFather.
TELEGRAM_BOT_TOKEN=
# REQUIRED. Random string (A-Z a-z 0-9 _ -), used in the webhook path and checked on every update. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# REQUIRED. The staff group for handoff cards and commands (looks like -100xxxxxxxxxx). The bot must be an admin there.
ADMIN_CHAT_ID=
# Public base URL of the server. Leave empty on Render (RENDER_EXTERNAL_URL is used) and for --polling.
PUBLIC_URL=
# Comma-separated Telegram user ids. Empty = everyone can use the bot.
ALLOWED_USER_IDS=
# Comma-separated Telegram user ids allowed to use /clear; they are also exempt from the per-user daily limit.
TESTER_IDS=

# --- Anthropic ---
# REQUIRED.
ANTHROPIC_API_KEY=
# claude-haiku-4-5 (cheapest, ~$0.01 per reply) or claude-sonnet-5-5 (smarter, ~$0.02 per reply)
MODEL=claude-haiku-4-5
# Only for models with thinking (Sonnet 5.5 and newer): effort low|medium|high, thinking adaptive|between_tools
LLM_EFFORT=low
LLM_THINKING=adaptive
# Prompt cache lifetime: 1h (fewer cache writes when chats pause) or 5m (cheaper writes, for continuous traffic)
CACHE_TTL=1h

# --- Database (Postgres; direct URLs such as postgresql://user:password@host/db?sslmode=require) ---
# REQUIRED. The bot's database.
DATABASE_URL=
# Optional, for tests only: a SEPARATE database. Each test creates and drops its own schema there.
TEST_DATABASE_URL=

# --- Shop data ---
# A shop folder relative to the repository (data/sample is the fictional demo shop), or "db" to read the shop data
# uploaded with: python -m salesbot.tools shop upload <folder>
SHOP_SOURCE=data/sample

# --- Behaviour ---
PERSONA_NAME=Микола
# Bot messages per reply the model may send, 1–5 (order templates don't count)
MAX_PARTS=3
DEBOUNCE_SECONDS=10
DEBOUNCE_MAX_WAIT=25
PART_GAP_MIN=1
PART_GAP_MAX=3

# --- Usage limits (0 = no limit) ---
# AI replies per client in 24 hours, and the estimated AI spend of the whole bot in 24 hours (USD)
DAILY_REPLIES_PER_USER=50
DAILY_BUDGET_USD=3
