# Copy to .env and fill in. .env is git-ignored; on Render set the same keys in the dashboard.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Random string, only A-Z a-z 0-9 _ - . Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Leave empty on Render (RENDER_EXTERNAL_URL is used). Not needed for --polling.
PUBLIC_URL=
# Group/channel ids look like -100xxxxxxxxxx
ADMIN_CHAT_ID=
PHOTO_CHANNEL_ID=
# Comma-separated Telegram user ids. Empty = everyone can use the bot.
ALLOWED_USER_IDS=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Postgres (Neon, direct non-pooler URLs ending in ?sslmode=require) ---
# The bot's database. Same value locally and in the Render dashboard.
DATABASE_URL=
# A separate Neon project/endpoint for tests; each test case runs in its own throwaway schema.
TEST_DATABASE_URL=

# --- Bot behaviour ---
PERSONA_NAME=Микола
# Claude model id (default claude-haiku-4-5)
MODEL=claude-haiku-4-5
DEBOUNCE_SECONDS=10
DEBOUNCE_MAX_WAIT=25
PART_GAP_MIN=1
PART_GAP_MAX=3
